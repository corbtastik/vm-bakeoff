# Shared VM defaults - sourced by lima.sh and lima-gen-yaml.sh
# Override these in vms/<vm>.env

: "${VM_NAME:=${VM}-vz}"
: "${VM_KIND:=ubuntu}"
: "${CPUS:=4}"
: "${MEMORY:=6GiB}"
: "${ROOT_DISK_SIZE:=20GiB}"
: "${FORWARDS:=}"

: "${HAS_DATA_DISK:=1}"
: "${DATA_DISK_NAME:=${VM}-data}"
: "${DATA_DISK_SIZE:=20GiB}"
